/**
 * Headers entity.
 * @author Devalgas.
 */
entity Headers {
  titleEn String
  subTitleEn String
  descriptionEn TextBlob
  titleFr String
  subTitleFr String
  descriptionFr TextBlob
  logo ImageBlob
}

/**
 * Footers entity.
 * @author Devalgas.
 */
entity Footers {
  titleEn String
  subTitleEn String
  descriptionEn TextBlob
  titleFr String
  subTitleFr String
  descriptionFr TextBlob
  logo ImageBlob
}


/**
 * CategoryArticle entity
 * @author Devalgas
 */
entity CategoryArticle {
  label String maxlength(256) unique required pattern(/^[A-Z].*$/)
  code String minlength(2) maxlength(2) unique required pattern(/^[A-Z]+$/)
  badge ImageBlob
  descriptionFr TextBlob
  descriptionEn TextBlob
}

/**
 * Article entity
 * @author Devalgas
 */
entity Article {
  labelEn String maxlength(256) unique required pattern(/^[A-Z].*$/)
  labelFR String maxlength(256) unique required pattern(/^[A-Z].*$/)
  descriptionFr TextBlob
  descriptionEn TextBlob
  markdownFr AnyBlob
  markdownEn AnyBlob
  status Status required
  date ZonedDateTime required
  badge ImageBlob
  banner ImageBlob
  views Integer
  stars Integer
}

/**
 * This is a subject
 * subject a class
 * @author Devalgas
 */
entity Subject {
  titleFr String maxlength(256) required
  titleEn String maxlength(256) required
}

/**
 * This is a subscribe
 * subscribe a class
 * @author Devalgas
 */
entity Subscribe {
  email String required pattern(/^[^@\s]+@[^@\s]+\.[^@\s]+$/)
  langKey String minlength(2) maxlength(2)
  countryKey String minlength(2)
  date ZonedDateTime
}


/**
 * Message entity
 * @author Devalgas
 */
entity Message {
  name String maxlength(256) required
  email String required pattern(/^[^@\s]+@[^@\s]+\.[^@\s]+$/)
  phone String pattern(/^\+?[0-9]{1,4}?[-.\s]?(\(?\d{1,3}?\)?[-.\s]?)?\d{3}[-.\s]?\d{3}[-.\s]?\d{4}$/)
  message TextBlob
  file AnyBlob
  city String maxlength(256)
  date ZonedDateTime
  langKey String minlength(2) maxlength(2)
  countryKey String minlength(2)
}


/**
 * This is a experience
 * experience a class
 * @author Devalgas
 */
entity Experience {
  titleFr String maxlength(256) required pattern(/^[A-Z].*$/)
  titleEn String maxlength(256) required pattern(/^[A-Z].*$/)
  company String maxlength(256) unique required pattern(/^[A-Z].*$/)
  descriptionFr TextBlob
  descriptionEn TextBlob
  logoCompany ImageBlob
  status Status required
  contract Contract
  startDate LocalDate
  endDate LocalDate
}

/**
 * Skill a entity
 * @author Devalgas
 */
entity Skill {
  title String maxlength(256) required pattern(/^[A-Z].*$/)
  descriptionEn TextBlob
  descriptionFn TextBlob
  icon ImageBlob
  level Level
}


/**
 * Language a enum
 * @author Devalgas
 */
enum Language {
  FRENCH(Fr), ENGLISH(En)
}

/**
 * ArticleStatus a enum
 * @author Devalgas
 */
enum Status {
  COMPLETED("Completed"), PENDING("Pending"), CANCELLED("Cancelled"), INPROGRESS("InProgress")
}

/* Contract a enum
 * @author Devalgas
 */
enum Contract {
  CDI("CDI"), CDD("CDD"), FREELANCE("Freelance")
}

/* Level a enum
 * @author Devalgas
 */
enum Level {
  BEGINNER("Beginner"), INTERMEDIATE("Intermediate"), ADVANCED("Advanced"), EXPERT("Expert"), MASTER("Master")
}

relationship ManyToMany {
  Article{categoryArticle(label) } to CategoryArticle
}

relationship ManyToOne {
  Message{subject(titleFr) required} to Subject
}


// Set pagination options
paginate Headers, Footers, CategoryArticle with infinite-scroll
paginate all with pagination except Headers, Footers, CategoryArticle

// Use Data Transfer Objects (DTO)
dto all with mapstruct except Headers, Footers

// Set service options to all except few
service all with serviceImpl except Headers, Footers

// Set an angular suffix
// angularSuffix * with mySuffix

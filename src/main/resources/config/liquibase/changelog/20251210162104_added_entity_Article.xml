<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd
                        http://www.liquibase.org/xml/ns/dbchangelog-ext http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd">

    <!--
        Added the entity Article.
    -->
    <changeSet id="20251210162104-1" author="jhipster">
        <createTable tableName="article" remarks="Article entity\n@author Devalgas">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="label_en" type="varchar(256)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_article__label_en" />
            </column>
            <column name="label_fr" type="varchar(256)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_article__label_fr" />
            </column>
            <column name="description_fr" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="description_en" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="markdown_fr" type="${blobType}">
                <constraints nullable="true" />
            </column>
            <column name="markdown_fr_content_type" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="markdown_en" type="${blobType}">
                <constraints nullable="true" />
            </column>
            <column name="markdown_en_content_type" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="status" type="varchar(255)">
                <constraints nullable="false" />
            </column>
            <column name="date" type="${datetimeType}">
                <constraints nullable="false" />
            </column>
            <column name="badge" type="${blobType}">
                <constraints nullable="true" />
            </column>
            <column name="badge_content_type" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="banner" type="${blobType}">
                <constraints nullable="true" />
            </column>
            <column name="banner_content_type" type="varchar(255)">
                <constraints nullable="true" />
            </column>
            <column name="views" type="integer">
                <constraints nullable="true" />
            </column>
            <column name="stars" type="integer">
                <constraints nullable="true" />
            </column>
            <!-- jhipster-needle-liquibase-add-column - JHipster will add columns here -->
        </createTable>
        <dropDefaultValue tableName="article" columnName="date" columnDataType="${datetimeType}"/>
    </changeSet>

    <changeSet id="20251210162104-1-relations" author="jhipster">

        <createTable tableName="rel_article__category_article">
            <column name="category_article_id" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="article_id" type="bigint">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey columnNames="article_id, category_article_id" tableName="rel_article__category_article"/>
    </changeSet>

    <!-- jhipster-needle-liquibase-add-changeset - JHipster will add changesets here -->


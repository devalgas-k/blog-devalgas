/**
 * Headers entity.
 * @author Devalgas.
 */
entity Headers {
  logoHeaders ImageBlob
}

/**
 * Footers entity.
 * @author Devalgas.
 */
entity Footers {
  logoFooters ImageBlob
}


/**
 * AppInfo entity.
 * @author Devalgas.
 */
entity AppInfo {
  keyInfo String
  valueInfo String
}

/**
 * CategoryArticle entity
 * @author Devalgas
 */
entity CategoryArticle {
  label String maxlength(256) unique required pattern(/^[A-Z].*$/)
  code String minlength(2) maxlength(2) unique required pattern(/^[A-Z]+$/)
  badge ImageBlob
  descriptionFr String
  descriptionEn String
}

/**
 * Article entity
 * @author Devalgas
 */
entity Article {
  labelEn String maxlength(256) unique required pattern(/^[A-Z].*$/)
  labelFr String maxlength(256) unique required pattern(/^[A-Z].*$/)
  descriptionFr String
  descriptionEn String
  markdownFr AnyBlob
  markdownEn AnyBlob
  status Status required
  date ZonedDateTime required
  badge ImageBlob
  banner ImageBlob
  views Integer
  stars Integer
}

/**
 * This is a subscribe
 * subscribe a class
 * @author Devalgas
 */
entity Subscribe {
  email String unique required pattern(/^[^@\s]+@[^@\s]+\.[^@\s]+$/)
  langKey String minlength(2) maxlength(2)
  countryKey String minlength(2)
  date ZonedDateTime
}


/**
 * Message entity
 * @author Devalgas
 */
entity Message {
  name String maxlength(256) required
  email String required pattern(/^[^@\s]+@[^@\s]+\.[^@\s]+$/)
  phone String pattern(/^\+?[0-9]{1,4}?[-.\s]?(\(?\d{1,3}?\)?[-.\s]?)?\d{3}[-.\s]?\d{3}[-.\s]?\d{4}$/)
  message String required maxlength(256)
  file AnyBlob maxbytes(5242880)
  date ZonedDateTime
  langKey String minlength(2) maxlength(2)
  countryKey String minlength(2)
}

/**
 * This is a subject
 * subject a class
 * @author Devalgas
 */
entity Subject {
  titleFr String maxlength(256) required
  titleEn String maxlength(256) required
}

/**
 * ArticleStatus a enum
 * @author Devalgas
 */
enum Status {
  COMPLETED("Completed"), PENDING("Pending"), CANCELLED("Cancelled"), INPROGRESS("InProgress")
}


relationship OneToMany {
  Footers{appInfoFooters(keyInfo)} to AppInfo
  Headers{appInfoHeaders(keyInfo)} to AppInfo
}

relationship ManyToMany {
  Article{categoryArticle(label) } to CategoryArticle
}

relationship ManyToOne {
  Message{subject(titleFr) required} to Subject
}



// Set pagination options
// paginate Headers, Footers with infinite-scroll
paginate * with pagination

// Use Data Transfer Objects (DTO)
// dto all with mapstruct except Headers, Footers
dto * with mapstruct

// Set service options to all except few
service * with serviceImpl

// Set an angular suffix
// angularSuffix * with mySuffix
